# Every parameter listed here must exist (deploy/push_ssm_params.sh) or instance bootstrap fails.
# The instance role needs deploy/ssm-read-policy.json attached to read them.
option_settings:
  aws:elasticbeanstalk:application:environmentsecrets:
    DJANGO_SECRET_KEY: arn:aws:ssm:us-east-1:322134621417:parameter/nycfood/DJANGO_SECRET_KEY
    GOOGLE_API_KEY: arn:aws:ssm:us-east-1:322134621417:parameter/nycfood/GOOGLE_API_KEY
    GOOGLE_PLACES_API_KEY: arn:aws:ssm:us-east-1:322134621417:parameter/nycfood/GOOGLE_PLACES_API_KEY
    GOOGLE_MAPS_JS_KEY: arn:aws:ssm:us-east-1:322134621417:parameter/nycfood/GOOGLE_MAPS_JS_KEY

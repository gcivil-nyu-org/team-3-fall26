# Copy to .env and fill in. Never commit .env.
# Google Places API (New) key, used by /restaurants/ for search results.
GOOGLE_API_KEY=your_key_here
# Optional: Maps JavaScript API key, used to show the results map.
GOOGLE_MAPS_JS_KEY=
# Gmail SMTP - no paid service:
#   1. Turn on 2-Step Verification on the sending Gmail account.
#   2. Create an app password at https://myaccount.google.com/apppasswords
#   3. Set EMAIL_BACKEND and the two values below.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=your_address@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
